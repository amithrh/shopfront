# syntax=docker/dockerfile:1
# AskOnce MCP server image, built for linux/arm64 (always pass --platform linux/arm64; Graviton Fargate / ECS Express Mode; AgentCore Runtime needs
# ARM64 too). Two stages: `builder` resolves the locked dependencies with uv, `runtime` carries only the
# virtualenv, the code and the data, and runs as an unprivileged user.
#
# Build from the REPOSITORY ROOT (the server needs ../packages/mcp-tasks, ../schema and ../profiles;
# /.dockerignore allow-lists exactly those):
#   docker buildx build --platform linux/arm64 -f server/Dockerfile -t askonce-mcp --load .
#
# Run locally (DEV-ONLY secrets, in-memory storage). Publish on loopback only: the DEV-ONLY keys are
# public, and the image binds 0.0.0.0 inside the container, so `-p 8000:8000` would expose them to the LAN:
#   docker run --rm -p 127.0.0.1:18000:8000 -e ASKONCE_ENV=dev -e ASKONCE_STORAGE=memory \
#     -e ASKONCE_PUBLIC_BASE_URL=http://localhost:18000 \
#     -v "$PWD/.local/profiles-live:/app/profiles-live:ro" askonce-mcp
#
# The image defaults to ASKONCE_ENV=prod + DynamoDB, so it refuses to start (exit code 2, one line per
# problem on stderr) until real secrets are injected (ASKONCE_REQUEST_STATE_KEYS,
# ASKONCE_OWNER_LINK_KEYS, ASKONCE_ID_KEY, ASKONCE_ADMIN_TOKEN: Secrets Manager) and the public names are
# set (ASKONCE_ALLOWED_HOSTS, ASKONCE_ALLOWED_ORIGINS, ASKONCE_CORS_ORIGINS, ASKONCE_PUBLIC_BASE_URL).
# infra/ (CDK stack AskOnceCore) does all of that.

ARG PYTHON_IMAGE=python:3.12-slim

FROM ghcr.io/astral-sh/uv:0.10.5 AS uv

# ---------------------------------------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv /uv /bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PROJECT_ENVIRONMENT=/app/server/.venv

WORKDIR /app/server

# 1) Dependencies only (cached until the lock file or the tasks package changes).
COPY packages/mcp-tasks /app/packages/mcp-tasks
COPY server/pyproject.toml server/uv.lock server/README.md /app/server/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# 2) The server itself (installed editable, so config.REPO_ROOT resolves to /app; the runtime stage
#    copies /app/server/src to the same path).
COPY server/src /app/server/src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# 3) DEV-SEED profiles: "live" copies of the three gold profiles, promoted the way
#    scripts/dev_seed_live.py does it (certification run id `dev-seed`, NOT a real certification).
#    They let a memory-storage container list the demo businesses without a mount; DynamoDB deployments
#    ignore profile dirs (profiles are published into the table: scripts/seed_dynamodb.py).
COPY profiles /app/profiles
COPY scripts/dev_seed_live.py /app/scripts/dev_seed_live.py
RUN /app/server/.venv/bin/python /app/scripts/dev_seed_live.py \
    && mv /app/.local/profiles-live /app/profiles-live \
    && printf '%s\n' \
       'DEV-SEED: live copies of the gold profiles generated by scripts/dev_seed_live.py at image build.' \
       'Certification run id "dev-seed" is NOT a real certification. Replace with certifier output.' \
       > /app/profiles-live/DEV-SEED.txt

# ---------------------------------------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime

LABEL org.opencontainers.image.title="askonce-mcp" \
      org.opencontainers.image.description="AskOnce multi-tenant MCP server (Streamable HTTP at :8000/mcp)" \
      org.opencontainers.image.source="https://github.com/amithrh/shopfront" \
      askonce.profiles-live="dev-seed (not certified): /app/profiles-live"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Unprivileged runtime user; the code and venv stay root-owned and read-only to it.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin askonce

COPY --from=builder /app/server/.venv /app/server/.venv
COPY --from=builder /app/server/src /app/server/src
COPY --from=builder /app/server/pyproject.toml /app/server/pyproject.toml
COPY --from=builder /app/packages/mcp-tasks /app/packages/mcp-tasks
COPY --from=builder /app/profiles-live /app/profiles-live
COPY schema /app/schema
COPY profiles /app/profiles

WORKDIR /app/server
USER askonce

ENV PATH="/app/server/.venv/bin:${PATH}" \
    ASKONCE_ENV=prod \
    ASKONCE_STORAGE=dynamodb \
    ASKONCE_HOST=0.0.0.0 \
    ASKONCE_PORT=8000 \
    ASKONCE_PROFILE_SCHEMA_PATH=/app/schema/business-profile.schema.json \
    ASKONCE_PROFILE_DIRS=/app/profiles-live \
    ASKONCE_FALLBACK_PROFILE=/app/schema/example-profile.json

EXPOSE 8000

# /health is unauthenticated and outside the MCP transport's Host check (ALB and Docker probes).
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"]

# 0.0.0.0:8000, MCP at POST /mcp (also the AgentCore Runtime contract).
CMD ["python", "-m", "askonce_server"]
